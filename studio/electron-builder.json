// electron-builder configuration for Kala Studio. The native backend and
// its static UI are prepared by `scripts/native-backend.cjs` at
// studio/backend-native/ and copied to resources/backend/ intact
// (kala-studio[.exe] + studio_dist/). The legacy Python/PyInstaller
// staging directory studio/backend/ is never copied into the native
// distribution.
//
// `linux.desktop` follows the `LinuxDesktopFile` schema from
// app-builder-lib (entry object holding `[Desktop Entry]` metadata).
// electron-builder derives `Categories` from `linux.category` and the
// `Comment` from `linux.description`, so the entry only carries the fields
// it alone can set. `desktopName` (package.json) plus `syncDesktopName` pin
// the `.desktop` file name, Electron's app id and `StartupWMClass` to
// `kala-studio`, which is what a Wayland desktop needs to link the window to
// its launcher entry.
//
// The icon lives in the build resources directory (`electron/`, which is
// `directories.buildResources`): `icon.svg` is the source, `icon.png` (512)
// and `icon-256.png` are the Linux sizes and `icon.ico` (16, 32, 48, 64, 128,
// 256) is the Windows one. Replace `icon.svg` to replace the mark; see the
// header of that file for the two commands that regenerate the rest.

{
  "appId": "com.kala-agent.studio",
  "productName": "Kala Studio",
  "asar": true,
  "directories": {
    "output": "release",
    "buildResources": "electron"
  },
  "files": [
    "electron/backend-log.cjs",
    "electron/bootstrap.cjs",
    "electron/main.cjs",
    "electron/preload.cjs",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "backend-native",
      "to": "backend"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "icon.ico",
    "artifactName": "kala-studio-${version}-setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Engineering",
    "icon": "icon.png",
    "synopsis": "Standalone mechanical design workspace",
    "description": "Kala Studio — a standalone parametric mechanical design workspace: agent chat, drafting sheet, STEP/STL export and FreeCAD.",
    "syncDesktopName": true,
    "desktop": {
      "entry": {
        "Name": "Kala Studio",
        "Comment": "Standalone mechanical design workspace",
        "Keywords": "cad;mechanical;design;fea;stl;step",
        "StartupWMClass": "kala-studio"
      }
    },
    "artifactName": "kala-studio-${version}-${arch}.${ext}",
    "executableName": "kala-studio"
  }
}