{
  "name": "kala-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Kala Studio desktop UI — standalone React + Three.js workspace for parametric mechanical design",
  "author": {
    "name": "Kala Agent contributors"
  },
  "type": "module",
  "main": "electron/bootstrap.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:native": "node scripts/native-backend.cjs",
    "check:native-readiness": "node scripts/native-readiness.cjs",
    "desktop": "node scripts/desktop.cjs",
    "desktop:pack": "node scripts/desktop-pack.cjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "happy-dom": "^21.0.3",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
