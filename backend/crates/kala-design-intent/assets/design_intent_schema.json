{
  "$defs": {
    "AssemblyStep": {
      "additionalProperties": false,
      "description": "Place a component, or fuse or compound several of them.",
      "properties": {
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "components": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Components",
          "type": "array"
        },
        "op": {
          "title": "Op",
          "type": "string"
        },
        "x": {
          "default": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0,
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "op"
      ],
      "title": "AssemblyStep",
      "type": "object"
    },
    "ComponentScript": {
      "additionalProperties": false,
      "description": "The operations that build one named solid.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/ComponentStep"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "name",
        "steps"
      ],
      "title": "ComponentScript",
      "type": "object"
    },
    "ComponentStep": {
      "additionalProperties": false,
      "description": "One operation inside a component.",
