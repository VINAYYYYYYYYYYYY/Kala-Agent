{
  "version": "0.1.0",
  "rules": {
    "focus": {
      "exploration": {
        "conditions": [
          {"feature": "step_id", "op": "lt", "value": 3},
          {"feature": "body_count", "op": "eq", "value": 0}
        ]
      },
      "refinement": {
        "conditions": [
          {"feature": "body_count", "op": "gte", "value": 1},
          {"feature": "fail_count", "op": "gte", "value": 2}
        ]
      },
      "validation": {
        "conditions": [
          {"feature": "analysis_keys", "op": "has_any", "value": ["stress", "thermal", "modal"]}
        ]
      }
    },
    "constraints_active": {
      "conditions": [
        {"feature": "last_n_tools", "op": "contains", "value": "constraint_add"},
        {"feature": "fail_count", "op": "gte", "value": 1}
      ]
    },
    "export_ready": {
      "conditions": [
        {"feature": "export_present", "op": "eq", "value": true},
        {"feature": "body_count", "op": "gte", "value": 1}
      ]
    },
    "search_density": {
      "low": {
        "conditions": [
          {"feature": "search_hits", "op": "lte", "value": 2}
        ],
        "value": 0.2
      },
      "medium": {
        "conditions": [
          {"feature": "search_hits", "op": "range", "min": 3, "max": 10}
        ],
        "value": 0.5
      },
      "high": {
        "conditions": [
          {"feature": "search_hits", "op": "gt", "value": 10}
        ],
        "value": 0.8
      }
    }
  },
  "defaults": {
    "focus": "exploration",
    "constraints_active": false,
    "export_ready": false,
    "search_density": 0.0
  }
}
